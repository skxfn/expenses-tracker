{
  "sourceLanguage" : "ru",
  "strings" : {
    "a11y.money" : {
      "comment" : "озвучка сумм (правило). Все имена VoiceOver с суммами. Проверить на iPhone с русским голосом; при другой валюте — её название. Аргументы: %lld — целая сумма в рублях",
      "extractionState" : "manual",
      "localizations" : {
