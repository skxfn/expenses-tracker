        }
      }
    },
    "a11y.money.fraction" : {
      "comment" : "copy.json a11y.money: озвучка сумм (правило). Все имена VoiceOver с суммами. Проверить на iPhone с русским голосом; при другой валюте — её название. Аргументы: %@ — сумма с копейками («142,60»): дробные — всегда «рубля»",
      "extractionState" : "manual",
      "localizations" : {
