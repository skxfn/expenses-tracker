    "add.batch.pill" : {
      "comment" : "пилюля пакета. Пилюля пакета после «Ещё одна»: число записанных и их сумма, по нажатию показывает записанное. Аргументы: %1$lld — число трат; %2$@ — сумма без знака валюты («21,50»)",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@ · %2$@"
